{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "serverListen": { "type": "string" },
        "publicUrl": { "type": "string" },
        "storageMode": { "type": "string", "enum": ["postgres"] }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "migrateOnStartup": { "type": "boolean" },
        "existingSecret": { "$ref": "#/definitions/secretRef" }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["dev", "oidc"] },
        "devModeEnabled": { "type": "boolean" },
        "devToken": { "type": "string" },
        "devTokenExistingSecret": { "$ref": "#/definitions/secretRef" }
      }
    },
    "oidc": {
      "type": "object",
      "properties": {
        "issuerUrl": { "type": "string" },
        "clientId": { "type": "string" },
        "clientSecret": { "type": "string" },
        "clientSecretExistingSecret": { "$ref": "#/definitions/secretRef" },
        "redirectUrl": { "type": "string" }
      }
    },
    "raw": { "$ref": "#/definitions/raw" },
    "reviews": { "$ref": "#/definitions/reviews" },
    "security": { "$ref": "#/definitions/security" },
    "storage": { "$ref": "#/definitions/storage" },
    "ingress": { "$ref": "#/definitions/ingress" },
    "gateway": { "$ref": "#/definitions/gateway" },
    "livenessProbe": { "$ref": "#/definitions/probe" },
    "readinessProbe": { "$ref": "#/definitions/probe" },
    "resources": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" }
  },
  "definitions": {
    "secretRef": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "raw": {
      "type": "object",
      "properties": {
        "requireAuthByDefault": { "type": "boolean" },
        "allowPublicNamespaces": { "type": "boolean" },
        "allowPublicPackages": { "type": "boolean" }
      }
    },
    "reviews": {
      "type": "object",
      "properties": {
        "requireApproval": { "type": "boolean" },
        "minimumApprovals": { "type": "integer", "minimum": 0 },
        "allowSelfApproval": { "type": "boolean" }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "secretScanning": { "type": "boolean" },
        "unsafeInstructionScanning": { "type": "boolean" }
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "maxArtifactFileBytes": { "type": "integer", "minimum": 1 },
            "maxUnpackedPackageBytes": { "type": "integer", "minimum": 1 },
            "maxArtifactsPerVersion": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array" }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "type": "object" },
        "parentRefs": { "type": "array" },
        "hostnames": { "type": "array", "items": { "type": "string" } },
        "sectionName": { "type": "string" }
      }
    },
    "probe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string" },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
